# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<db>

# Optional
PORT=5001
LANGUAGE_CODE=en-IN
TTS_SPEAKER=priya
# AGENT_NAME=Riya            # a person's name for the agent; wins over the KB's chatbot_config.assistant_name
# STT_LANGUAGE_CODE=unknown  # auto-detect the caller's language (default: same as LANGUAGE_CODE)
# LLM_MAX_TOKENS=1000
# LOG_LEVEL=debug

# Hotels to load at start-up (KB + welcome audio), so the very first call
# after a restart is greeted instantly. Comma-separated ndids.
# PREWARM_NDIDS=

# Seconds of dead air before the agent checks in ("Hello? Are you there?"), in ms.
# SILENCE_MS=10000
# false = the agent says goodbye but never ends the call itself.
# AGENT_CAN_HANG_UP=true

# ---- Per-hotel switches from the dashboard ----
# Collection with one document per hotel: { ndid, voiceEnabled, whatsappIntegrationEnabled }.
# When set, WhatsApp is used ONLY for hotels whose whatsappIntegrationEnabled is true.
# Empty = switch not used (WhatsApp on for every hotel that has a WhatsApp account).
HOTEL_SETTINGS_COLLECTION=
# Said when WhatsApp is off and a caller asks for a brochure/photos, unless the hotel's
# settings document has its own message (whatsappDefaultMessage / defaultMessage).
# WHATSAPP_OFF_MESSAGE=Our team will send it to you shortly.

# ---- WhatsApp (Meta Cloud API) ----
# Collection where each hotel's WhatsApp account doc lives (ndid, accessToken, phoneNumberInfo, wabaInfo)
WHATSAPP_ACCOUNT_COLLECTION=hotelwhatsappaccounts
# The platform's Meta system-user token (the one the Eazotel WhatsApp backend sends with).
# Many tokens saved on the account documents are expired (Meta error 190) — set this if
# `npm run check:whatsapp -- <ndid>` says the token is invalid.
WHATSAPP_ACCESS_TOKEN=
# If a hotel's KB and its WhatsApp number are saved under DIFFERENT ndids, say which
# WhatsApp account each KB should send from:  <kb ndid>:<whatsapp ndid>,<kb ndid>:<whatsapp ndid>
# (same effect as adding &wa_ndid=<whatsapp ndid> to the Exotel applet URL)
# WHATSAPP_NDID_MAP=
META_API_VERSION=v25.0
DEFAULT_COUNTRY_CODE=91
# true = log every WhatsApp payload instead of sending it (testing)
# WHATSAPP_DRY_RUN=true

# Approved templates for callers who have never messaged the hotel on WhatsApp (24h rule).
# Create them with: npm run create:templates -- <ndid> --create
# WHATSAPP_TEMPLATE_DOCUMENT=voice_call_brochure
# WHATSAPP_TEMPLATE_IMAGE=voice_call_photos
# WHATSAPP_TEMPLATE_TEXT=voice_call_followup
# WHATSAPP_TEMPLATE_LANG=en
